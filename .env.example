# --- Compiler only -------------------------------------------------------
# Needed to run `pilot create` and `pilot repair`.
# Running an already-compiled Pilot never calls a model and never needs a key.
OPENAI_API_KEY=
PILOT_COMPILER_MODEL=gpt-5.6-sol
# Reasoning effort, when the model supports it: none, minimal, low, medium,
# high, xhigh, max. Left unset, the model's own default applies. Exploration is
# tool-calling in a loop rather than one hard think, so raising this costs more
# than it usually buys; lower it if compiles are pricier than they are wrong.
# PILOT_COMPILER_EFFORT=

# --- Registry (optional) -------------------------------------------------
# A MongoDB connection string. Set it to publish, install, and report Pilot
# health. Leave it blank and everything else works exactly as before — Pilots
# on disk are still the source of truth.
PILOT_REGISTRY_URI=
# PILOT_REGISTRY_DB=pilot
# Recorded as the publisher of a Pilot and the reporter of health events.
# PILOT_PUBLISHER=anonymous

# --- Optional official APIs ----------------------------------------------
# Pilot asks for these, with the signup URL and this file's absolute path,
# only when compiling or running a site backed by that API. Secret values are
# passed to the generated script at runtime and are never written to pilot.json.
# Geoapify signup: https://myprojects.geoapify.com/register
# GEOAPIFY_API_KEY=

# --- Optional paths ------------------------------------------------------
# PILOT_PILOTS_DIR=pilots
# PILOT_CONFIG=config/pilots.json
# PILOT_LOCK_FILE=pilot.lock.json
# PILOT_CAPABILITIES_DIR=config/capabilities

# --- Local test board ----------------------------------------------------
# PILOT_TESTBOARD_PORT=4100
